# --- Database ---
DATABASE_URL=postgres://mcp:mcp@localhost:5432/mcp

# --- Encryption ---
# Generate with: openssl rand -base64 32
MCP_MASTER_KEY=REPLACE_ME_BASE64_32_BYTES

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/accounts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/accounts

# --- App base URL (used to build OAuth metadata) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth (MCP) ---
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# --- forward_message ---
# Recipients allowed for forward_message, comma-separated. Each entry is an
# exact address (alice@example.com) or a domain (example.com / @example.com,
# exact domain only — subdomains must be listed separately).
# Every to/cc/bcc recipient must match. Empty = all forwards are refused.
FORWARD_ALLOWLIST=
