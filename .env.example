# --- Database ---
DATABASE_URL=postgres://mcp:mcp@localhost:5432/mcp

# --- Encryption ---
# Generate with: openssl rand -base64 32
MCP_MASTER_KEY=REPLACE_ME_BASE64_32_BYTES

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/accounts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/accounts

# --- App base URL (used to build OAuth metadata) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth (MCP) ---
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# --- forward_message ---
# Recipients forward_message may send to (README > Forwarding allowlist).
# Separate entries with commas, semicolons or spaces; case-insensitive.
#   alice@example.com  -> that exact address
#   example.com        -> any address at that domain (also @example.com);
#                         exact domain only, sub.example.com must be listed
# Every to/cc/bcc recipient must match, otherwise nothing is sent.
# Empty = every forward is refused (feature off).
# After a change: docker compose up -d app (no rebuild needed).
FORWARD_ALLOWLIST=

# Access control (optional). Comma-separated Clerk user IDs allowed to use this
# instance; any other signed-in user is rejected. Setting it also disables /sign-up.
# For full protection, also set Clerk Dashboard > Access mode to Invite-only.
ALLOWED_CLERK_USER_IDS=
# DISABLE_SIGNUP=true
